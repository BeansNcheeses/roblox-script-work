-- =============================================================================
function TradeUI:populateInventory()
    self:setFilter("All")
end

function TradeUI:refreshInventory()
    -- Clear existing items
    for _, child in ipairs(self.InvList:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    -- Filter
    local filteredItems = {}
    for _, item in ipairs(self.InventoryItems) do
        if self.ActiveFilter == "All" or item.Rarity == self.ActiveFilter then
            table.insert(filteredItems, item)
        end
    end
    
    -- Sort by value descending
    table.sort(filteredItems, function(a, b)
        return a.Value > b.Value
    end)
    
    self.InvTitle.Text = "YOUR INVENTORY  (" .. #filteredItems .. ")"
    
    -- Create rows
    local yPos = 0
    local rowHeight = 50
    local rowGap = 2
    
    for _, item in ipairs(filteredItems) do
        local isInOffer = false
        for _, offered in ipairs(self.YourOffer) do
            if offered.Name == item.Name then
                isInOffer = true
                break
            end
        end
        
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -4, 0, rowHeight)
        row.Position = UDim2.fromOffset(2, yPos)
        row.BackgroundColor3 = isInOffer and Color3.fromRGB(50, 60, 55) or Color3.fromRGB(42, 42, 50)
        row.BorderSizePixel = 0
        row.Parent = self.InvList
        addCorner(row, 4)
        row.Data = { item = item }
        
        -- Rarity bar (left edge)
        local rarityColor = getRarityColor(item.Rarity)
        local rarityBar = Instance.new("Frame")
        rarityBar.Size = UDim2.fromOffset(3, rowHeight - 6)
        rarityBar.Position = UDim2.fromOffset(3, 3)
        rarityBar.BackgroundColor3 = rarityColor
        rarityBar.BorderSizePixel = 0
        rarityBar.Parent = row
        addCorner(rarityBar, 2)
        
        -- Item icon
        local iconBg = Instance.new("Frame")
        iconBg.Size = UDim2.fromOffset(36, 36)
        iconBg.Position = UDim2.fromOffset(10, 7)
        iconBg.BackgroundColor3 = Color3.fromRGB(55, 55, 64)
        iconBg.BorderSizePixel = 0
        iconBg.Parent = row
        addCorner(iconBg, 4)
        
        local iconChar = (item.Type == "Knife") and "🔪" or "🔫"
        local iconText = createText(iconBg, iconChar, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 16)
        iconText.TextYAlignment = Enum.TextYAlignment.Center
        iconText.TextXAlignment = Enum.TextXAlignment.Center
        iconText.TextColor3 = Color3.fromRGB(220, 220, 230)
        
        -- Item name
        local nameLabel = createText(row, item.Name, UDim2.fromOffset(160, 20), UDim2.fromOffset(52, 6), 13)
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.Font = Enum.Font.GothamSemibold
        nameLabel.TextColor3 = isInOffer and Color3.fromRGB(130, 190, 130) or Color3.fromRGB(240, 240, 240)
        
        -- Rarity tag
        local rarityLabel = createText(row, item.Rarity, UDim2.fromOffset(80, 16), UDim2.fromOffset(52, 26), 10)
        rarityLabel.TextXAlignment = Enum.TextXAlignment.Left
        rarityLabel.Font = Enum.Font.GothamBold
        rarityLabel.TextColor3 = rarityColor
        
        -- Value
        local valueText = createText(row, "✦ " .. formatValue(item.Value), UDim2.fromOffset(80, 18), UDim2.fromOffset(196, 16), 11)
        valueText.TextXAlignment = Enum.TextXAlignment.Right
        valueText.TextColor3 = Color3.fromRGB(255, 200, 50)
        
        -- "ADDED" overlay if already in offer
        if isInOffer then
            local addedLabel = createText(row, "ADDED", UDim2.fromOffset(52, 16), UDim2.fromOffset(225, 30), 9)
            addedLabel.TextXAlignment = Enum.TextXAlignment.Right
            addedLabel.TextColor3 = Color3.fromRGB(90, 210, 90)
        end
        
        -- Click to add item
        row.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 and not isInOffer then
                self:addToOffer(item)
            end
        end)
        
        row.MouseEnter:Connect(function()
            if not isInOffer then
                row.BackgroundColor3 = Color3.fromRGB(52, 52, 62)
            end
        end)
        
        row.MouseLeave:Connect(function()
            row.BackgroundColor3 = isInOffer and Color3.fromRGB(50, 60, 55) or Color3.fromRGB(42, 42, 50)
        end)
        
        yPos = yPos + rowHeight + rowGap
    end
    
    self.InvList.CanvasSize = UDim2.fromOffset(0, yPos + 4)
end

