function TradeUI:populateInventory()
    self.InventoryItems = {}
    for _, itemData in ipairs(CONFIG.FakeInventoryItems) do
        table.insert(self.InventoryItems, itemData)
    end
    self:setFilter("All")
end

function TradeUI:refreshInventory()
    -- Clear existing items
    for _, child in ipairs(self.InvList:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    -- Filter items
    self.FilteredItems = {}
    for _, item in ipairs(self.InventoryItems) do
        local category = item.Rarity
        if item.Rarity == "Chroma" then
            category = "Chroma"
        end
        if self.ActiveFilter == "All" or item.Rarity == self.ActiveFilter or category == self.ActiveFilter then
            table.insert(self.FilteredItems, item)
        end
    end
    
    -- Sort by value (descending)
    table.sort(self.FilteredItems, function(a, b)
        return a.Value > b.Value
    end)
    
    -- Create item rows
    local yPos = 0
    local itemHeight = 56
    local itemGap = 2
    
    for i, item in ipairs(self.FilteredItems) do
        local row = makeRoundedFrame(self.InvList, UDim2.new(1, -4, 0, itemHeight), 
            UDim2.new(0, 2, 0, yPos), STYLE.BgItem, 4)
        row.Data = { item = item }
        
