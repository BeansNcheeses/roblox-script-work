        confirmGui:Destroy()
        self._confirmOpen = false
        self:resetAcceptState()
        self:setStatus("Trade cancelled", Color3.fromRGB(190, 190, 195))
    end)
    
    confirmBtn.MouseButton1Click:Connect(function()
        log("TRADE_CONFIRMED", "User confirmed the trade (final)")
        confirmBtn.Text = "CONFIRMED ✓"
        confirmBtn.BackgroundColor3 = Color3.fromRGB(45, 120, 55)
        confirmBtn.Active = false
        
        -- Flash effect
        local flash = Instance.new("Frame")
        flash.Size = UDim2.fromScale(1, 1)
        flash.BackgroundColor3 = Color3.fromRGB(60, 220, 80)
        flash.BackgroundTransparency = 1
        flash.BorderSizePixel = 0
        flash.ZIndex = 100
        flash.Parent = confirmGui
        
        local tInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(flash, tInfo, { BackgroundTransparency = 0.6 })
        tween:Play()
        tween.Completed:Wait()
        
        local doneText = createText(confirmGui, "TRADE COMPLETED!", UDim2.new(1, -200, 0, 50), UDim2.new(0, 100, 0.5, -25), 34)
        doneText.ZIndex = 101
        doneText.TextColor3 = Color3.fromRGB(60, 220, 80)
        
        createText(confirmGui, "Items have been added to your inventory", UDim2.new(1, -200, 0, 24), UDim2.new(0, 100, 0.5, 28), 14):SetAttribute("TextColor3", Color3.fromRGB(190, 190, 195))
        
        task.wait(3)
        confirmGui:Destroy()
        self:destroy()
    end)
    
    -- Fade in
    confirmWin.BackgroundTransparency = 1
    local fadeTween = TweenService:Create(confirmWin, TweenInfo.new(0.3), { BackgroundTransparency = 0 })
    fadeTween:Play()
end

