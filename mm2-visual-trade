        rarityBar.Position = UDim2.new(0, 4, 0, 3)
        rarityBar.BackgroundColor3 = rarityColor
        rarityBar.BorderSizePixel = 0
        rarityBar.Parent = row
        
        local rarityBarUIC = Instance.new("UICorner")
        rarityBarUIC.CornerRadius = UDim.new(0, 2)
        rarityBarUIC.Parent = rarityBar
        
        -- Item icon placeholder (colored box simulating item thumbnail)
        local iconBg = makeRoundedFrame(row, UDim2.new(0, 40, 0, 40), UDim2.new(0, 12, 0, 8), 
            Color3.fromRGB(40, 40, 55), 4)
        
        -- Icon letter (simulating knife/gun icon)
