-- =============================================================================
-- LOGGER
-- =============================================================================
local function log(action, details)
    if not CONFIG.EnableLogging then return end
    local ts = os.date("!%Y-%m-%dT%H:%M:%SZ")
    warn(string.format("[MM2-PENTEST] [%s] %s | %s | Player: %s", ts, action, details, player.Name))
end

-- =============================================================================
-- UTILITY: Create rounded frame
-- =============================================================================
local function makeRoundedFrame(parent, size, pos, color, radius)
    local f = Instance.new("Frame")
    f.Size = size
    f.Position = pos
    f.BackgroundColor3 = color
    f.BorderSizePixel = 0
    f.Parent = parent
    
    local uic = Instance.new("UICorner")
    uic.CornerRadius = UDim.new(0, radius or 6)
    uic.Parent = f
    
    return f
end

local function makeTextLabel(parent, size, pos, text, color, sizeText, font, align)
    local l = Instance.new("TextLabel")
    l.Size = size
    l.Position = pos
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = color or STYLE.TextPrimary
    l.TextSize = sizeText or 14
    l.Font = font or Enum.Font.GothamBold
    l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.RichText = true
    l.Parent = parent
    return l
end

local function makeImageLabel(parent, size, pos, image, transparency)
    local l = Instance.new("ImageLabel")
    l.Size = size
    l.Position = pos
    l.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    l.BackgroundTransparency = 0.5
    l.BorderSizePixel = 0
    l.Image = image or ""
    l.ImageTransparency = transparency or 0
    l.BackgroundTransparency = 0.3
    l.Parent = parent
    
    local uic = Instance.new("UICorner")
    uic.CornerRadius = UDim.new(0, 4)
    uic.Parent = l
    
    return l
end

