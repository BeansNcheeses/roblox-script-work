local function makeCard(index, tier, countText)
	local card = createFrame(gridHolder, UDim2.fromOffset(76, 96), UDim2.fromOffset(0, 0), C.PanelDeep, 6)
	card.LayoutOrder = index
	addStroke(card, tier.color, 1, 0.55)

	-- icon placeholder block
	local icon = createFrame(card, UDim2.fromOffset(48, 48), UDim2.new(0.5, -24, 0, 12), C.Slot, 6)
	addStroke(icon, C.StrokeSoft, 1)
	createText(icon, "◆", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 20,
		tier.color, Enum.Font.GothamBold, Enum.TextXAlignment.Center)

	-- count badge
	if countText then
		local badge = createFrame(card, UDim2.fromOffset(30, 15), UDim2.new(1, -34, 0, 4), C.Window, 4)
		addStroke(badge, C.StrokeSoft, 1)
		createText(badge, countText, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 9,
			C.TextSoft, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
	end

	-- tier ribbon
	local ribbon = createFrame(card, UDim2.fromOffset(38, 13), UDim2.fromOffset(5, 62), tier.color, 3)
	createText(ribbon, tier.name, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 8,
		Color3.fromRGB(18, 20, 28), Enum.Font.GothamBold, Enum.TextXAlignment.Center)

	-- name bar
	local nameBar = createFrame(card, UDim2.new(1, -10, 0, 18), UDim2.new(0, 5, 1, -23), C.Slot, 4)
	createText(nameBar, "Item " .. index, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 10,
		C.TextMain, Enum.Font.GothamBold, Enum.TextXAlignment.Center)

	return card
end

