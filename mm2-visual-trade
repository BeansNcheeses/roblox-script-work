function TradeUI.new()
    local self = setmetatable({}, TradeUI)
    
    self.YourOffer = {}       -- items you've added (max 4)
    self.TheirOffer = {}      -- their offered items
    self.InventoryItems = {}  -- all items in left panel
    self.Accepted = false     -- has local player accepted?
    self.CooldownActive = false
    self.ActiveFilter = "All"
    self.FilteredItems = {}
    
    self:buildScreen()
    self:populateInventory()
    self:populateTheirOffer()
    
    return self
end

