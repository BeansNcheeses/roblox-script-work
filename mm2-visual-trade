local GAP, SLOT_W, SLOT_H = 6, 0, 92
SLOT_W = math.floor((R_W - GAP * 3) / 4)

local function makeSlot(parent, index, tier, filled)
	local slot = createFrame(parent, UDim2.fromOffset(SLOT_W, SLOT_H),
		UDim2.fromOffset((index - 1) * (SLOT_W + GAP), 0),
		filled and C.Slot or C.SlotEmpty, 7)
	addStroke(slot, filled and tier.color or C.StrokeSoft, filled and 2 or 1,
		filled and 0 or 0.3)

	if not filled then
		createText(slot, "+", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 22,
			C.TextMuted, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
		return slot
	end

	local icon = createFrame(slot, UDim2.fromOffset(44, 44), UDim2.new(0.5, -22, 0, 8), C.PanelDeep, 6)
	addStroke(icon, C.StrokeSoft, 1)
	createText(icon, "◆", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 19,
		tier.color, Enum.Font.GothamBold, Enum.TextXAlignment.Center)

	local nameBar = createFrame(slot, UDim2.new(1, -12, 0, 18), UDim2.new(0, 6, 1, -24), tier.color, 4)
	createText(nameBar, "Slot " .. index, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 10,
		Color3.fromRGB(18, 20, 28), Enum.Font.GothamBold, Enum.TextXAlignment.Center)

	return slot
end

