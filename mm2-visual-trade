-- =============================================================================
-- ADD ITEM TO OFFER
-- =============================================================================
function TradeUI:addToOffer(item)
    if #self.YourOffer >= 4 then
        self:setStatus("You can only trade up to 4 items!", Color3.fromRGB(255, 180, 50))
        return
    end
    
    -- Check if already added
    for _, existing in ipairs(self.YourOffer) do
        if existing.Name == item.Name then
            self:setStatus("Item already in your offer!", Color3.fromRGB(255, 200, 50))
            return
        end
    end
    
    table.insert(self.YourOffer, item)
    log("ITEM_ADDED", string.format("Added %s (✦%s) to offer", item.Name, formatValue(item.Value)))
    self:setStatus(string.format("Added %s (✦%s) to your offer", item.Name, formatValue(item.Value)), Color3.fromRGB(180, 220, 180))
    
    -- Rebuild all slots
    self:rebuildYourSlots()
    
    -- Reset accept state
    self:resetAcceptState()
end

-- =============================================================================
-- REMOVE ITEM FROM OFFER
-- =============================================================================
function TradeUI:removeFromOffer(slotIndex)
    local slot = self.YourSlots[slotIndex]
    if not slot or not slot.Data.item then return end
    
    local itemName = slot.Data.item.Name
    slot.Data.item = nil
    
    -- Rebuild offer list from slots
    local newOffer = {}
    for i = 1, 4 do
        if self.YourSlots[i].Data.item then
            table.insert(newOffer, self.YourSlots[i].Data.item)
        end
    end
    self.YourOffer = newOffer
    
    self:rebuildYourSlots()
    self:resetAcceptState()
    
    log("ITEM_REMOVED", string.format("Removed %s from offer", itemName))
    self:setStatus(string.format("Removed %s from your offer", itemName), Color3.fromRGB(190, 190, 195))
end

-- =============================================================================
-- REBUILD YOUR SLOTS
-- =============================================================================
function TradeUI:rebuildYourSlots()
    -- Clear all slots
    for i = 1, 4 do
        self:updateYourSlot(i, nil)
    end
    
    -- Fill with current offer
    for i, item in ipairs(self.YourOffer) do
        self:updateYourSlot(i, item)
    end
    
    self:updateValues()
    self:refreshInventory()
    self:updateYourPanelTitle()
end

function TradeUI:updateYourPanelTitle()
    self.YourPanelTitle.Text = string.format("YOUR OFFER  (%d/4)", #self.YourOffer)
end

-- =============================================================================
-- UPDATE VALUE DISPLAYS
-- =============================================================================
function TradeUI:updateValues()
    local yourTotal = 0
    for _, item in ipairs(self.YourOffer) do
        yourTotal = yourTotal + item.Value
    end
    local theirTotal = 0
    for _, item in ipairs(self.TheirOffer) do
        theirTotal = theirTotal + item.Value
    end
    
    self.YourValueText.Text = "Your value: ✦ " .. formatValue(yourTotal)
    self.TheirValueText.Text = "Their value: ✦ " .. formatValue(theirTotal)
    
    -- Win/Loss
    local diff = theirTotal - yourTotal
    if #self.YourOffer > 0 then
        if diff > 0 then
            self.WLLabel.Text = string.format("▲ WIN  (+✦%s)", formatValue(diff))
            self.WLLabel.TextColor3 = Color3.fromRGB(80, 220, 80)
        elseif diff < 0 then
            self.WLLabel.Text = string.format("▼ LOSS  (✦%s)", formatValue(math.abs(diff)))
            self.WLLabel.TextColor3 = Color3.fromRGB(235, 80, 80)
        else
            self.WLLabel.Text = "— FAIR TRADE —"
            self.WLLabel.TextColor3 = Color3.fromRGB(190, 190, 195)
        end
    else
        self.WLLabel.Text = ""
    end
end

-- =============================================================================
-- ACCEPT COOLDOWN (3.5 seconds, matching real MM2)
-- =============================================================================
function TradeUI:startAcceptCooldown()
    if self.CooldownActive then return end
    if #self.YourOffer == 0 then return end
    
    self.CooldownActive = true
    self.AcceptButton.Text = ""
    self.AcceptButton.BackgroundColor3 = Color3.fromRGB(45, 100, 55)
    self.CooldownBar.Visible = true
    self.CooldownText.Visible = true
    
    -- Update status
    self.YourAcceptedLabel.Text = "ACCEPTING..."
    self.YourAcceptedLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
    self:setStatus("Accepting trade... please wait", Color3.fromRGB(255, 200, 50))
    
    log("COOLDOWN_START", "Accept cooldown started (3.5s)")
    
    local duration = CONFIG.AcceptCooldown
    local elapsed = 0
    local cdId = tick()
    self._cdId = cdId
    
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if self._cdId ~= cdId then
            conn:Disconnect()
            return
        end
        
        elapsed = elapsed + dt
        local progress = math.min(elapsed / duration, 1)
        local remaining = math.max(duration - elapsed, 0)
        
        self.CooldownBar.Size = UDim2.fromScale(progress, 1)
        self.CooldownText.Text = string.format("%.1fs", remaining)
        
        if progress >= 1 then
            conn:Disconnect()
            self:completeAccept()
        end
    end)
end

function TradeUI:completeAccept()
    self.CooldownBar.Size = UDim2.fromScale(1, 1)
    task.wait(0.2)
    
    self.Accepted = true
    self.CooldownActive = false
    self.CooldownBar.Visible = false
    self.CooldownText.Visible = false
    self.AcceptButton.Text = "ACCEPTED ✓"
    self.AcceptButton.BackgroundColor3 = Color3.fromRGB(52, 165, 76)
    
    self.YourAcceptedLabel.Text = "ACCEPTED ✓"
    self.YourAcceptedLabel.TextColor3 = Color3.fromRGB(80, 220, 80)
    
    log("TRADE_ACCEPTED", "User accepted the trade (step 1)")
    self:setStatus("You accepted! Waiting for " .. CONFIG.TradePartnerName .. " to confirm...", Color3.fromRGB(80, 220, 80))
    
    -- Show final confirmation after a short delay (real MM2 behavior)
    task.wait(1.2)
    self:showConfirmationScreen()
end

function TradeUI:resetAcceptState()
    self.Accepted = false
    self.CooldownActive = false
    self.CooldownBar.Size = UDim2.fromScale(0, 1)
    self.CooldownBar.Visible = false
    self.CooldownText.Visible = false
    self._cdId = nil
    self.AcceptButton.Text = "ACCEPT"
    self.AcceptButton.BackgroundColor3 = Color3.fromRGB(52, 165, 76)
    self.YourAcceptedLabel.Text = "WAITING"
    self.YourAcceptedLabel.TextColor3 = Color3.fromRGB(190, 190, 195)
end

