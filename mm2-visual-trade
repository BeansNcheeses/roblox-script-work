        local iconLabel = makeTextLabel(iconBg, UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0),
            iconChar, STYLE.TextPrimary, 18, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
        iconLabel.TextYAlignment = Enum.TextYAlignment.Center
        iconLabel.BackgroundTransparency = 1
        
        -- Item name
        local nameLabel = makeTextLabel(row, UDim2.new(0, 200, 0, 20), UDim2.new(0, 58, 0, 6),
            item.Name, STYLE.TextPrimary, 13, Enum.Font.GothamSemibold, Enum.TextXAlignment.Left)
        
        -- Rarity + Type tag
        local rarityLabel = makeTextLabel(row, UDim2.new(0, 120, 0, 16), UDim2.new(0, 58, 0, 26),
            item.Rarity .. " " .. item.Type, rarityColor, 11, Enum.Font.GothamBold, Enum.TextXAlignment.Left)
        
        -- Value
