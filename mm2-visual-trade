local function addSlot(parent, index)
    local slot = Instance.new("Frame")
    slot.Size = UDim2.fromOffset(slotW, slotH)
    slot.Position = UDim2.fromOffset((index-1)*(slotW + slotGap), 0)
    slot.BackgroundColor3 = C.SlotEmpty
    slot.BorderSizePixel = 0
    slot.Parent = parent
    addCorner(slot, 6)
    addStroke(slot, C.Stroke, 1)

    -- Plus icon for empty slots
    local plus = Instance.new("TextLabel")
    plus.Size = UDim2.fromScale(1, 1)
    plus.Position = UDim2.fromScale(0, 0)
    plus.BackgroundTransparency = 1
    plus.Text = "+"
    plus.TextSize = 24
    plus.TextColor3 = C.TextMuted
    plus.Font = Enum.Font.GothamBold
    plus.Parent = slot
end

-- Your Offer Slots (4)
