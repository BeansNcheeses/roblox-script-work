            pcall(function() child.BackgroundTransparency = 1 end)
            pcall(function() child.TextTransparency = 1 end)
        end
    end
    
    task.wait(0.05)
    
    -- Animate in
    local allDescendants = self.Main:GetDescendants()
    for _, child in ipairs(allDescendants) do
        if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("ImageLabel") then
            local targetBG = 0
            local targetText = 0
            if child:IsA("Frame") then
                targetBG = child.BackgroundTransparency
                child.BackgroundTransparency = 1
            elseif child:IsA("TextLabel") or child:IsA("TextButton") then
                targetText = child.TextTransparency
                child.TextTransparency = 1
                if child:IsA("TextButton") then
                    child.BackgroundTransparency = 1
                end
            end
            
            task.spawn(function()
                task.wait(math.random() * 0.05)
                local tInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                local props = {}
                if child:IsA("Frame") or (child:IsA("TextButton") and child ~= self.CloseBtn) then
                    props.BackgroundTransparency = targetBG
                end
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    props.TextTransparency = targetText
                end
                local tween = TweenService:Create(child, tInfo, props)
                tween:Play()
            end)
        end
    end
    
    self.Main.BackgroundTransparency = 0
    task.wait(0.3)
    
    -- Unhide specific elements
    self.CooldownBar.Visible = false
    self.CooldownText.Visible = false
end

