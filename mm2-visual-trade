        self.StatusLabel.TextColor3 = color
    end
end

-- =============================================================================
-- FORMAT VALUE
-- =============================================================================
function TradeUI:formatValue(val)
    if val >= 1000000 then
        return string.format("%.1fM", val / 1000000)
    elseif val >= 1000 then
        return string.format("%.1fK", val / 1000)
    else
        return tostring(val)
    end
end

