            string.format("✦ %s", self:formatValue(item.Value)), STYLE.TextValue, 12, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
        
        -- Value shadow
        makeTextLabel(row, UDim2.new(0, 90, 0, 16), UDim2.new(1, -98, 0, 18),
            string.format("✦ %s", self:formatValue(item.Value)), STYLE.TextValueShadow, 12, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
        
        -- Add to offer button (click the whole row)
