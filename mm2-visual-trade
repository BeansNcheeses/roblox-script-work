-- =============================================================================
-- ADD ITEM TO OFFER
-- =============================================================================
function TradeUI:addToOffer(item)
    if #self.YourOffer >= CONFIG.MaxItems then
        self:setStatus("You can only trade up to " .. CONFIG.MaxItems .. " items!", Color3.fromRGB(255, 100, 100))
        return
    end
    
    -- Check if already added
    for _, offered in ipairs(self.YourOffer) do
        if offered.Name == item.Name then
            self:setStatus("Item already in your offer!", Color3.fromRGB(255, 200, 50))
            return
        end
    end
    
    table.insert(self.YourOffer, item)
    
    -- Find empty slot
    for i = 1, CONFIG.MaxItems do
        if not self.YourSlots[i].Data.item then
            self:updateYourSlot(i, item)
            break
        end
    end
    
    self:updateValues()
    self:updateOfferHeader()
    log("ITEM_ADDED", string.format("Added %s (✦%d) to offer", item.Name, item.Value))
    self:setStatus(string.format("Added %s (✦%s) to your offer", item.Name, self:formatValue(item.Value)), STYLE.TextPrimary)
end

-- =============================================================================
-- REMOVE ITEM FROM OFFER
-- =============================================================================
function TradeUI:removeFromOffer(slotIndex)
    local slot = self.YourSlots[slotIndex]
    if not slot or not slot.Data.item then return end
    
    local itemName = slot.Data.item.Name
    slot.Data.item = nil
    self:updateYourSlot(slotIndex, nil)
    
    -- Remove from list and shift remaining items
    local newOffer = {}
    for i = 1, CONFIG.MaxItems do
        local s = self.YourSlots[i]
        if s.Data.item then
            table.insert(newOffer, s.Data.item)
        end
    end
    self.YourOffer = newOffer
    
    -- Re-populate slots
    for i = 1, CONFIG.MaxItems do
        self.YourSlots[i].Data.item = nil
        self:updateYourSlot(i, nil)
    end
    for i, item in ipairs(self.YourOffer) do
        self.YourSlots[i].Data.item = item
        self:updateYourSlot(i, item)
    end
    
    self:updateValues()
    self:updateOfferHeader()
    self:resetAcceptState()
    log("ITEM_REMOVED", string.format("Removed %s from offer", itemName))
    self:setStatus(string.format("Removed %s from your offer", itemName), STYLE.TextSecondary)
end

-- =============================================================================
-- UPDATE VALUE DISPLAYS
-- =============================================================================
function TradeUI:updateValues()
    local yourTotal = 0
    for _, item in ipairs(self.YourOffer) do
        yourTotal = yourTotal + item.Value
    end
    
    local theirTotal = 0
    for _, item in ipairs(self.TheirOffer) do
        theirTotal = theirTotal + item.Value
    end
    
    self.YourValueLabel.Text = string.format("Value: ✦ %s", self:formatValue(yourTotal))
    self.TheirValueLabel.Text = string.format("Value: ✦ %s", self:formatValue(theirTotal))
    
    -- Win/Loss calculation
    local diff = theirTotal - yourTotal
    if #self.YourOffer > 0 then
        if diff > 0 then
            self.WLLabel.Text = string.format("▲ WIN  (+✦ %s)", self:formatValue(diff))
            self.WLLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        elseif diff < 0 then
            self.WLLabel.Text = string.format("▼ LOSS  (✦ %s)", self:formatValue(math.abs(diff)))
            self.WLLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
        else
            self.WLLabel.Text = "— FAIR TRADE —"
            self.WLLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
    else
        self.WLLabel.Text = ""
