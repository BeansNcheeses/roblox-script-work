        if not self.CooldownActive then
            self.AcceptBtn.BackgroundColor3 = STYLE.AcceptGreen
        end
    end)
    
    -- Fade in animation
    self.Main.BackgroundTransparency = 1
    self.Main.Visible = true
    for _, child in ipairs(self.Main:GetDescendants()) do
