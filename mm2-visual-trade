function TradeUI:setFilter(category)
    self.ActiveFilter = category
    for cat, btn in pairs(self.TabButtons) do
        if cat == category then
            btn.BackgroundColor3 = Color3.fromRGB(52, 120, 200)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(48, 48, 56)
            btn.TextColor3 = Color3.fromRGB(170, 170, 180)
        end
    end
    self:refreshInventory()
end

