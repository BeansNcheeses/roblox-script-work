-- =============================================================================
-- ACCEPT COOLDOWN (3-second realistic delay)
-- =============================================================================
function TradeUI:startAcceptCooldown()
    if self.CooldownActive then return end
    if #self.YourOffer == 0 then
        self:setStatus("Add items to your offer first!", Color3.fromRGB(255, 200, 50))
        return
    end
    
    self.CooldownActive = true
    self.AcceptBtn.Text = ""
    self.AcceptBtn.Active = false
    self.CooldownBar.Visible = true
    self.CooldownText.Visible = true
    self.AcceptBtn.BackgroundColor3 = STYLE.AcceptGreenDisabled
    
    -- Simulate the real MM2 cooldown
    local duration = CONFIG.AcceptCooldown
    local elapsed = 0
    local cooldownId = tick()
    self._cooldownId = cooldownId
    
    log("ACCEPT_COOLDOWN_START", string.format("Starting %.1fs cooldown", duration))
    
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if self._cooldownId ~= cooldownId then
            conn:Disconnect()
            return
        end
        
        elapsed = elapsed + dt
        local progress = math.min(elapsed / duration, 1)
        local remaining = math.max(duration - elapsed, 0)
        
        self.CooldownBar.Size = UDim2.new(progress, 0, 1, 0)
        self.CooldownText.Text = string.format("Accepting...  %.1fs", remaining)
        
        if progress >= 1 then
            conn:Disconnect()
            self:completeAccept()
        end
    end)
end

function TradeUI:completeAccept()
    self.CooldownBar.Size = UDim2.new(1, 0, 1, 0)
    task.wait(0.15)
    
    self.Accepted = true
    self.CooldownActive = false
    self.CooldownBar.Visible = false
    self.CooldownText.Visible = false
    self.AcceptBtn.Text = "  ✓  Accepted!"
    self.AcceptBtn.BackgroundColor3 = STYLE.AcceptGreen
    self.AcceptBtn.Active = true
    
    log("TRADE_ACCEPTED", "User accepted the trade")
    self:setStatus("You accepted the trade! Waiting for " .. CONFIG.TradePartnerName .. "...", Color3.fromRGB(0, 255, 100))
    
    -- After a short delay, show final confirmation screen (like real MM2)
    task.wait(1.5)
    self:showConfirmationScreen()
end

function TradeUI:resetAcceptState()
    self.Accepted = false
    self.CooldownActive = false
    self.CooldownBar.Visible = false
    self.CooldownText.Visible = false
    self.AcceptBtn.Text = "  ✓  Accept Trade"
    self.AcceptBtn.BackgroundColor3 = STYLE.AcceptGreen
    self.AcceptBtn.Active = true
    self.CooldownBar.Size = UDim2.new(0, 0, 1, 0)
    self._cooldownId = nil
end

