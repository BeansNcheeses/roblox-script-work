local TradeUI = {}
TradeUI.__index = TradeUI

function TradeUI.new(targetName)
    local self = setmetatable({}, TradeUI)
    self.TargetName = targetName
    CONFIG.TradePartnerName = targetName
    self.YourOffer = {}
    self.TheirOffer = {}
    for _, item in ipairs(THEIR_OFFER) do
        table.insert(self.TheirOffer, item)
    end
    self.InventoryItems = {}
    for _, item in ipairs(MM2_ITEMS) do
        table.insert(self.InventoryItems, {Name = item.Name, Rarity = item.Rarity, Type = item.Type, Value = item.Value})
    end
    self.ActiveFilter = "All"
    self.Accepted = false
    self.CooldownActive = false
    self.AcceptStep = 0 -- 0=not accepted, 1=first accept done, 2=confirmed
    
    self:buildUI()
    self:populateInventory()
    self:populateTheirOfferSlots()
    
    log("TRADE_OPENED", string.format("Trade opened with target: %s", targetName))
    
    return self
end

